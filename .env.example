# Required for the /api and /admin routes to work. Without these, the server
# still starts and /health responds, but every Supabase-backed route returns
# a 500 with a clear "not configured" style error instead of crashing.
#
# Get these from your Supabase project settings (Project Settings > API).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Defaults to 3000, and to whatever Railway/Railpack injects at deploy time.
PORT=3000
