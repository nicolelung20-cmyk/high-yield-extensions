{
  "manifest_version": 3,
  "name": "Traffic Analytics Pro",
  "version": "1.0.0",
  "description": "Earn money by sharing anonymous browsing analytics. Help advertisers understand user behavior.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Traffic Analytics Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
