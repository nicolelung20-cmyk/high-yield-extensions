#!/usr/bin/env bash
# spawn - launch an agent backend for this venture.
#
# Lives in the repo on purpose. An earlier version of this tool existed only
# at /tmp/spawn-install.sh and was lost when the container was reclaimed;
# anything that needs to survive a reclaim has to be committed.

set -euo pipefail

VERSION="0.1.0"

# Hermes checkout location. HERMES_DIR wins; otherwise take the first candidate
# that exists, falling back to ~/hermes-agent so the "absent" message names a
# sensible path to clone into. $HOME is not always the working user's home in a
# container, so /home/user is checked too.
default_hermes_dir() {
  local c
  for c in "$HOME/hermes-agent" /home/user/hermes-agent /opt/hermes-agent; do
    [ -d "$c" ] && { printf '%s\n' "$c"; return; }
  done
  printf '%s\n' "$HOME/hermes-agent"
}
HERMES_DIR="${HERMES_DIR:-$(default_hermes_dir)}"

usage() {
  cat <<'__SPAWN_USAGE__'
spawn - launch an agent backend

USAGE
  spawn <target> [mode]
  spawn doctor
  spawn --help | --version

TARGETS
  hermes [local|docker|ssh]   Hermes Agent (Nous Research). Default mode: local.

COMMANDS
  doctor                      Report which backends are usable, and why not.

ENVIRONMENT
  HERMES_DIR                  Hermes checkout (default: ~/hermes-agent)

EXAMPLES
  spawn hermes local
  spawn doctor
__SPAWN_USAGE__
}

# Resolve the hermes entrypoint, preferring a venv built inside the checkout.
hermes_bin() {
  if [ -x "$HERMES_DIR/.venv/bin/hermes" ]; then
    printf '%s\n' "$HERMES_DIR/.venv/bin/hermes"
  elif command -v hermes >/dev/null 2>&1; then
    command -v hermes
  else
    return 1
  fi
}

# A present entrypoint does not mean a working agent: the CLI can dispatch
# --version fine while the agent runtime fails to import. Probe the core
# dependency pair that actually breaks (pydantic against the running Python).
hermes_runtime_ok() {
  local py="$HERMES_DIR/.venv/bin/python"
  [ -x "$py" ] || return 0   # no venv to judge; the caller reports that already
  "$py" -c 'import pydantic, openai' 2>/dev/null
}

doctor() {
  local ok=0
  printf 'spawn %s\n\n' "$VERSION"

  printf 'hermes:\n'
  if bin=$(hermes_bin); then
    if hermes_runtime_ok; then
      printf '  status     ready\n  entrypoint %s\n' "$bin"
      ok=1
    else
      printf '  status     DEGRADED - cli runs, agent runtime does not import\n'
      printf '  entrypoint %s\n' "$bin"
      printf '  detail     %s\n' \
        "$("$HERMES_DIR/.venv/bin/python" -c 'import pydantic, openai' 2>&1 | tail -1)"
      printf '  likely     pinned pydantic vs this Python build (3.14.0rc2 changed\n'
      printf '             typing._eval_type). Needs final 3.14.0, which requires a\n'
      printf '             newer uv than %s.\n' "$(uv --version 2>/dev/null || echo unknown)"
    fi
  else
    printf '  status     NOT READY\n'
    if [ -d "$HERMES_DIR" ]; then
      printf '  checkout   %s (present)\n' "$HERMES_DIR"
      printf '  missing    no built venv - dependencies were never installed\n'
      printf '  fix        cd %s && uv sync\n' "$HERMES_DIR"
      printf '  note       needs a uv new enough for this repo uv.lock schema;\n'
      printf '             uv 0.8.17 rejects it. Check with: uv --version\n'
    else
      printf '  checkout   %s (absent)\n' "$HERMES_DIR"
      printf '  fix        git clone --depth 1 \\\n'
      printf '               https://github.com/NousResearch/hermes-agent.git %s\n' "$HERMES_DIR"
    fi
  fi

  printf '\nuv:\n'
  if command -v uv >/dev/null 2>&1; then
    printf '  %s\n' "$(uv --version)"
  else
    printf '  not installed\n'
  fi

  [ "$ok" -eq 1 ] || return 1
}

run_hermes() {
  local mode=local
  local bin
  # A first arg that looks like a flag is meant for hermes, not a mode, so
  # `spawn hermes --version` works as well as `spawn hermes local --version`.
  case "${1:-}" in
    ''|-*) ;;
    *) mode="$1"; shift ;;
  esac

  # Validate the mode before checking the install, so a typo is reported as a
  # typo rather than as a missing backend.
  case "$mode" in
    local|docker|ssh) ;;
    *) echo "spawn: unknown hermes mode '$mode' (want: local, docker, ssh)" >&2; return 2 ;;
  esac

  if ! bin=$(hermes_bin); then
    echo "spawn: hermes is not installed or not built." >&2
    echo "spawn: run 'spawn doctor' for the specific reason and fix." >&2
    return 127
  fi

  # Remaining args pass straight through to hermes, so `spawn hermes local
  # --version` or `spawn hermes local chat` behave as you'd expect.
  if [ "$mode" = local ]; then
    exec "$bin" "$@"
  fi
  exec "$bin" --terminal "$mode" "$@"
}

main() {
  [ $# -gt 0 ] || { usage; return 2; }
  case "$1" in
    -h|--help)    usage ;;
    -V|--version) printf 'spawn %s\n' "$VERSION" ;;
    doctor)       doctor ;;
    hermes)       shift; run_hermes "$@" ;;
    *) echo "spawn: unknown target '$1'" >&2; echo >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
